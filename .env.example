# --- Application ---
PORT=3000

# --- Database (PostgreSQL running in Docker, see docker-compose.yml) ---
# Credentials MUST match the docker-compose.yml postgres service.
DATABASE_URL="postgresql://claro:claro_dev_password@localhost:5433/claro_de_luna?schema=public"

# --- OTP delivery (DEV phase, no real email provider) ---
# When true: the request response includes the plaintext `otp` AND logs it to the console.
# When false: the `otp` field is omitted from the response (other fields remain).
EXPOSE_OTP_IN_RESPONSE=true

# --- OTP policy ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# --- JWT (HS256, stateless) ---
# Both secrets MUST be at least 32 characters long.
JWT_ACCESS_SECRET="replace_me_with_a_secure_access_secret_min_32c"
JWT_REFRESH_SECRET="replace_me_with_a_secure_refresh_secret_min_32c"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Check-in code (venue-level rotating entry code) ---
# HMAC secret used to derive the rotating 4-digit venue check-in code.
# MUST be at least 32 characters long. Keep it private to the venue/server.
CHECKIN_VENUE_SECRET="replace_me_with_a_secure_checkin_secret_min_32c"
# Optional tuning (defaults shown): rotation period and code length.
CHECKIN_PERIOD_SECONDS=3600
CHECKIN_CODE_DIGITS=4

# --- Admin panel service session (Option B) ---
# Shared key the admin panel sends to POST /auth/admin/session to obtain an
# admin JWT. Required and MUST be at least 32 characters long. Never commit the
# real value; provide it per environment. The admin app receives it via
# `--dart-define ADMIN_PANEL_KEY`.
ADMIN_PANEL_KEY="replace_me_with_a_secure_panel_key_min_32c"
